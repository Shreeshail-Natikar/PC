{
  "name": "private-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "setup": "npm run install:all && npm run prisma:setup",
    "prisma:generate": "cd server && npx prisma generate",
    "prisma:setup": "cd server && npx prisma generate && npx prisma db push",
    "build": "cd client && npm run build",
    "postinstall": "npm run prisma:generate",
    "build": "cd client && npm run build"
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "cd server && NODE_ENV=production node src/index.js",
    "start:prod": "npm run build && npm start",
    "prisma:studio": "cd server && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
