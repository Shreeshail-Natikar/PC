PORT=5001
NODE_ENV=development

# PostgreSQL (Neon / Supabase / Railway / Render / self-hosted)
# Neon free tier example: postgresql://user:PASS@ep-xx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Always wrap in quotes.
DATABASE_URL="postgresql://neondb_owner:npg_zXBoibt4QD6A@ep-polished-lake-axn5b4od-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

MAX_USERS=2

# Optional (prod only): comma-separated allowlist of CORS origins
# Leave blank to allow any origin (dev default, still requires credentials cookie handshake)
CLIENT_ORIGIN=
